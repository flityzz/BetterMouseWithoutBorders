<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with every Windows 10 (1903+) and Windows 11 install,
         so the exe runs on the other PC without installing anything (no admin needed). -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BetterMouseWithoutBorders</AssemblyName>
    <RootNamespace>BetterMouse</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.6.1</Version>
    <Product>Better Mouse Without Borders</Product>
    <AssemblyTitle>Better Mouse Without Borders</AssemblyTitle>
    <Description>Share one mouse and keyboard between PCs on a local network.</Description>
    <Copyright>MIT</Copyright>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
    <!-- Login-screen service host (ServiceBase, ServiceController). -->
    <Reference Include="System.ServiceProcess" />
    <InternalsVisibleTo Include="BetterMouse.Tests" />
  </ItemGroup>

</Project>
